---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  guides: [string, string, string, string, string];
  audiences: [string, string];
}

const { guides, audiences } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideBase = `${base}/${Astro.locals.starlightRoute.locale === 'ru' ? 'ru/' : ''}`;
const linkedGuides = new Set(['create-mission', 'example-mission', 'git']);
const topics = [
  { id: 'create-mission', icon: 'add-document' },
  { id: 'example-mission', icon: 'open-book' },
  { id: 'git', icon: 'github' },
  { id: 'triad-tactics', icon: 'setting' },
  { id: 'api', icon: 'code-branch' },
] as const;
---

<section class="ll-guide-home not-content" aria-labelledby="_top">
  <div class="ll-guide-list">
    {topics.map((topic, index) => (
      <article class="ll-guide-entry" aria-labelledby={topic.id}>
        <span class="ll-entry-icon"><Icon name={topic.icon} size="1.125rem" /></span>
        <div class="ll-entry-body">
          <h2 id={topic.id}>
            {linkedGuides.has(topic.id)
              ? <a href={`${guideBase}${topic.id}/`}>{guides[index]}</a>
              : guides[index]}
          </h2>
          {topic.id === 'api' && (
            <ul class="ll-guide-audiences">
              {audiences.map((audience, audienceIndex) => (
                <li>
                  <h3 id={audienceIndex === 0 ? 'scripting' : 'website-integration'}>{audience}</h3>
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .ll-guide-home { margin-block: 0 2rem; }
  .ll-guide-list {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    background: var(--ll-color-surface);
  }
  .ll-guide-entry {
    position: relative;
    display: flex;
    align-items: baseline;
    min-width: 0;
    min-height: 5rem;
    padding: 1.5rem;
    gap: 0.875rem;
  }
  .ll-guide-entry + .ll-guide-entry {
    border-block-start: 1px solid var(--sl-color-hairline-light);
  }
  .ll-entry-icon {
    flex-shrink: 0;
    color: var(--sl-color-text-accent);
  }
  .ll-entry-icon :global(svg) { vertical-align: -0.125em; }
  .ll-entry-body { flex: 1; min-width: 0; }
  h2 {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  h2 a { color: inherit; text-decoration: none; }
  h2 a::after { content: ''; position: absolute; inset: 0; }
  .ll-guide-entry:has(a):hover,
  .ll-guide-entry:has(a:focus-visible) {
    background: var(--sl-color-accent-low);
  }
  .ll-guide-entry:first-child { border-radius: 0.5rem 0.5rem 0 0; }
  h2 a:focus-visible { outline: none; }
  h2 a:focus-visible::after {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
    border-radius: inherit;
  }
  .ll-guide-audiences {
    margin: 0.5rem 0 0;
    padding-inline-start: 1.125rem;
    list-style-type: disc;
    color: var(--sl-color-gray-3);
  }
  h3 {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    color: inherit;
  }
</style>
