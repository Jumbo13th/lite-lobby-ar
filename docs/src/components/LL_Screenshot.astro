---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  originalLabel: string;
}

const { src, alt, caption, originalLabel } = Astro.props;

for (const [name, value] of Object.entries({ alt, caption, originalLabel })) {
  if (typeof value !== 'string' || !value.trim()) {
    throw new Error(`LL_Screenshot requires nonempty ${name}.`);
  }
}
---

<figure>
  <a class="original" href={src.src} target="_blank" rel="noopener noreferrer" aria-label={`${originalLabel}: ${caption}`}>
    <Image
      src={src}
      alt={alt}
      layout="constrained"
      fit="contain"
      format="webp"
      quality={90}
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>
    <span>{caption}</span>
    <a href={src.src} target="_blank" rel="noopener noreferrer">{originalLabel}</a>
  </figcaption>
</figure>

<style>
  figure {
    margin: 2rem 0;
  }

  .original {
    display: block;
    width: fit-content;
    max-width: 100%;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
